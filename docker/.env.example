# ==============================================================================
# Personal Media Stack Environment Configuration (Windows 11 Docker Desktop)
# Copy this file to ".env" and adjust paths/secrets before running:
#   docker compose up -d
# ==============================================================================

# Timezone (IANA format, e.g., America/New_York, America/Chicago, America/Los_Angeles)
TZ=America/New_York

# User/Group IDs for LinuxServer.io containers (1000/1000 works cleanly with Docker Desktop on Windows)
PUID=1000
PGID=1000

# ------------------------------------------------------------------------------
# STORAGE PATHS (Use forward slashes on Windows Docker Desktop, e.g. D:/Media)
# ------------------------------------------------------------------------------
# App configuration/databases (put on fast internal SSD for snappy UI/metadata)
CONFIG_ROOT=C:/MediaStack/config

# Main Plex + *arr unified data root (MUST be a single volume so hardlinks & instant moves work)
# Expected subfolders created by setup-folders.ps1:
#   D:/Media/torrents/{movies,tv}
#   D:/Media/library/{movies,tv,home-movies}
DATA_ROOT=D:/Media

# Strictly isolated private adult library root (NEVER mounted into Plex or *arr)
# Expected subfolders:
#   D:/Private/stash/inbox     (MeTube drops finished downloads here)
#   D:/Private/stash/library   (Organized Stash media)
#   D:/Private/stash/generated (Thumbnails, previews, sprites)
STASH_ROOT=D:/Private/stash

# ------------------------------------------------------------------------------
# GLUETUN VPN CONFIGURATION (ExpressVPN via OpenVPN)
# IMPORTANT: Use your dedicated Manual Configuration OpenVPN username & password
# from the ExpressVPN web dashboard (Account -> Set Up Other Devices -> Manual
# Configuration) — NOT your regular ExpressVPN account email/password!
# ------------------------------------------------------------------------------
VPN_SERVICE_PROVIDER=expressvpn
VPN_TYPE=openvpn
OPENVPN_USER=REPLACE_WITH_EXPRESSVPN_MANUAL_OPENVPN_USER
OPENVPN_PASSWORD=REPLACE_WITH_EXPRESSVPN_MANUAL_OPENVPN_PASSWORD
OPENVPN_PROTOCOL=udp
SERVER_COUNTRIES=United States

# Optional: set to your LAN subnet so local web UIs can reach qBittorrent & MeTube via Gluetun
FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24,100.64.0.0/10
