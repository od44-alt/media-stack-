# ==============================================================================
# Personal Media Stack Environment Configuration (Windows 11 Docker Desktop)
# Copy this file to ".env" and adjust paths/secrets before running:
#   docker compose up -d
# ==============================================================================

# Timezone (IANA format, e.g., America/Winnipeg, America/New_York, America/Los_Angeles)
TZ=America/Winnipeg

# User/Group IDs for LinuxServer.io containers (1000/1000 works cleanly with Docker Desktop on Windows)
PUID=1000
PGID=1000

# ------------------------------------------------------------------------------
# STORAGE PATHS (Use forward slashes on Windows Docker Desktop, e.g. G:/Media)
# ------------------------------------------------------------------------------
# App configuration/databases (Internal SATA SSD: E:)
CONFIG_ROOT=E:/MediaStack/config

# Main Plex + *arr unified data root (Internal 2TB NVMe SSD: G: — single volume for hardlinks & instant moves)
# Expected subfolders created by setup-folders.ps1:
#   G:/Media/torrents/{movies,tv}
#   G:/Media/library/{movies,tv,home-movies}
DATA_ROOT=G:/Media

# Strictly isolated private adult library root (Dedicated 1TB Internal SATA SSD: F: — NEVER mounted into Plex or *arr)
# Expected subfolders:
#   F:/Private/stash/inbox     (MeTube drops finished downloads here)
#   F:/Private/stash/library   (Organized Stash media)
#   F:/Private/stash/generated (Thumbnails, previews, sprites)
STASH_ROOT=F:/Private/stash

# ------------------------------------------------------------------------------
# GLUETUN VPN CONFIGURATION (ExpressVPN via OpenVPN)
# IMPORTANT: Use your dedicated Manual Configuration OpenVPN username & password
# from the ExpressVPN web dashboard (Account -> Set Up Other Devices -> Manual
# Configuration) — NOT your regular ExpressVPN account email/password!
# ------------------------------------------------------------------------------
VPN_SERVICE_PROVIDER=expressvpn
VPN_TYPE=openvpn
OPENVPN_USER=REPLACE_WITH_EXPRESSVPN_MANUAL_OPENVPN_USER
OPENVPN_PASSWORD=REPLACE_WITH_EXPRESSVPN_MANUAL_OPENVPN_PASSWORD
OPENVPN_PROTOCOL=udp
SERVER_COUNTRIES=Canada

# LAN subnet (10.0.0.0/24) + Tailscale CGNAT range so local & remote UIs can reach qBittorrent & MeTube via Gluetun
FIREWALL_OUTBOUND_SUBNETS=10.0.0.0/24,100.64.0.0/10
